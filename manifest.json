{
  "manifest_version": 3,
  "name": "Tab Dedup",
  "version": "1.0.1",
  "description": "Detects duplicate tabs and offers to switch to existing ones. Keyboard navigation and custom domain rules.",
  "author": "Kerry Jones",
  "homepage_url": "https://github.com/kerryjones/tab-dedup",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["tabs", "webNavigation", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["chooser/chooser.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
